    "@vueuse/core": "^14.1.0",
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
